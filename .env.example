# Copy to .env.local for local dev, and add the same values in Vercel:
# Project → Settings → Environment Variables. See the README for where each one comes from.

# Firebase service account (Project settings → Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole key in quotes, with the \n's left as-is
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Login for /admin
ADMIN_USERNAME=
ADMIN_PASSWORD=
